# Default: offline extraction; Flask dependency is required. No key needed for tools.
RAG_PROVIDER=offline
RAG_RETRIEVER=bm25
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Gemini: RAG_PROVIDER=gemini, RAG_RETRIEVER=bm25 (no embedding/index rebuild).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# openai + hybrid: chat generation and BM25 + vector retrieval.
# Make prices explicit before estimating costs; no price is assumed.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
EMBEDDING_USD_PER_MILLION=
